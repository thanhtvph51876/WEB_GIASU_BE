SERVER_PORT=8080
APP_ENV=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tutor_platform?TimeZone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT. Replace before staging/production with a long random value.
JWT_SECRET=change-me-to-long-random-secret-change-before-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS. application.yml reads indexed origins.
CORS_ALLOWED_ORIGINS_1=http://localhost:3000
CORS_ALLOWED_ORIGINS_2=http://localhost:5173
CORS_ALLOWED_ORIGINS_3=https://example.com

# Upload/private file storage
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files
STORAGE_PROVIDER=local

# Payment sandbox defaults
PAYMENT_MODE=sandbox
PAYMENT_PROVIDER=simulated
ENABLED_GATEWAYS=bank_qr,vnpay,momo,payos,stripe
DEFAULT_GATEWAY=bank_qr
PAYMENT_TIMEOUT_MINUTES=30

# Verification provider
VERIFICATION_PROVIDER=mock

# Auth email/token URLs
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
AUTH_EXPOSE_DEV_TOKENS=false

# Demo seed. Keep false in staging/production unless the database is disposable.
SEED_DATA_ENABLED=false

# Finance
COMMISSION_RATE=0.15
